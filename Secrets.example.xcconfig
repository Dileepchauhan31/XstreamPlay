// ============================================================================
//  Secrets.example.xcconfig
//
//  Copy this file to `Secrets.xcconfig` (which is git-ignored) and fill in
//  your own TMDB credentials. Nothing in this repo ever contains a real token.
//
//      cp Secrets.example.xcconfig Secrets.xcconfig
//
//  Get a v4 Read Access Token from:
//      https://www.themoviedb.org/settings/api
//
//  NOTE: xcconfig treats "//" as a comment, so never put a full URL here —
//  store hosts only and build the URL in AppEnvironment.
// ============================================================================

TMDB_API_HOST = api.themoviedb.org
TMDB_IMAGE_HOST = image.tmdb.org

// Your TMDB v4 Read Access Token (a long JWT starting with "eyJ...").
TMDB_ACCESS_TOKEN = PASTE_YOUR_TMDB_READ_ACCESS_TOKEN_HERE
